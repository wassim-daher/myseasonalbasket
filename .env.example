# Copy to .env.development.local for `pnpm dev`. Placeholders only — never commit real values.

# The farm's database, as the restricted shop_runtime role (see Farm Agent docs/online-shop.md).
# Locally, after Farm Agent's `pnpm local:setup`:
SHOP_DATABASE_URL=postgresql://shop_runtime:local-shop-only@127.0.0.1:54322/postgres
# Supabase's root certificate for hosted databases (PEM). Leave empty locally.
SHOP_DATABASE_CA_CERT=
# The farm this store sells for (Farm.id in Farm Agent).
SHOP_FARM_ID=00000000-0000-0000-0000-000000000000
# Public address of the site, used in links and WhatsApp messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
